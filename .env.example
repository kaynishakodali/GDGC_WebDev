# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted. This does not control API origin validation.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Backend / PostgreSQL
DATABASE_URL="postgresql://postgres:replace_with_postgres_password@127.0.0.1:5432/artstudio?schema=public"
PORT=4000
HOST=127.0.0.1
NODE_ENV=development
APP_ORIGIN="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001"
TRUST_PROXY=false

# Set both before running `npm run db:seed`. Use a new password with at least 12 characters.
STUDIO_ADMIN_EMAIL="curator@example.com"
STUDIO_ADMIN_PASSWORD="replace_with_a_unique_12_plus_character_password"
STUDIO_ADMIN_NAME="Studio Curator"

# Optional development-only mock data (never active in production builds).
VITE_DEMO_MODE=false
